{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vayusetu.org/spec/hotspot-event.schema.json",
  "title": "VayuSetu Hotspot Event Schema",
  "description": "Open schema for detected air pollution hotspots where satellite/model PM2.5 exceeds station network interpolation.",
  "type": "object",
  "required": [
    "event_id",
    "tenant",
    "cell_id",
    "timestamp",
    "latitude",
    "longitude",
    "predicted_pm25",
    "station_idw_baseline",
    "residual_pm25",
    "confidence",
    "population_exposed",
    "schema_version"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique identifier for the hotspot event"
    },
    "tenant": {
      "type": "string",
      "description": "Tenant/city key (e.g. ncr, lko)"
    },
    "cell_id": {
      "type": "string",
      "description": "0.01° grid cell ID (e.g. ncr-2863-7731)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of observation"
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90,
      "description": "Cell center latitude"
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180,
      "description": "Cell center longitude"
    },
    "predicted_pm25": {
      "type": "number",
      "minimum": 0,
      "description": "Model estimated PM2.5 in µg/m³"
    },
    "station_idw_baseline": {
      "type": "number",
      "minimum": 0,
      "description": "Nearest station Inverse Distance Weighting estimate in µg/m³"
    },
    "residual_pm25": {
      "type": "number",
      "description": "The residual: predicted_pm25 - station_idw_baseline"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence score [0, 1]"
    },
    "population_exposed": {
      "type": "integer",
      "minimum": 0,
      "description": "Estimated population living within the 1 km grid cell"
    },
    "attribution": {
      "type": "object",
      "properties": {
        "cause": { "type": "string" },
        "cause_category": {
          "type": "string",
          "enum": [
            "crop_residue_burning",
            "waste_burning",
            "construction_dust",
            "industrial_plume",
            "vehicular_smoke",
            "dust_storm",
            "secondary_formation",
            "meteorological_trapping",
            "unknown"
          ]
        },
        "confidence": { "type": "number" },
        "evidence_cited": {
          "type": "array",
          "items": { "type": "string" }
        },
        "narrative": { "type": "string" }
      }
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    }
  }
}
